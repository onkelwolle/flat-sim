{
  "name": "flat-sim",
  "private": true,
  "version": "0.0.0",
  "description": "Browser app for planning furniture placement on scaled floor plans",
  "license": "MIT",
  "homepage": "https://onkelwolle.github.io/flat-sim/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelwolle/flat-sim.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks || true",
    "screenshot": "UPDATE_SCREENSHOT=1 playwright test e2e/readme-screenshot.spec.ts"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "konva": "^10.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
